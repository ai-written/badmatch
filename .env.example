# BadMatch 环境变量配置
# 复制此文件为 .env 后修改

# 数据库密码（生产环境务必修改）
DB_PASSWORD=badminton

# JWT 密钥（生产环境必填！用 openssl rand -hex 32 生成）
# 留空、使用示例值、或长度不足 32 字节时，服务会【拒绝启动】——
# 这是刻意的 fail-closed：默认密钥是公开的，一旦被使用任何人都能伪造出
# 任意用户（含超级管理员）的登录凭证。
SECRET_KEY=

# 生产模式开关（true=开发，false=生产）
# DEBUG=false 时：SQL 不打印、错误信息不外露
DEBUG=false

# 是否信任反向代理写入的转发头（X-Real-IP / X-Forwarded-For）
# 默认 false（安全）：这些头任何客户端都能自己伪造，信任它们会让所有按 IP 的
# 限流可被一行 header 绕过、审计日志里的来源 IP 也变得不可信。
# 仅当服务【只允许反向代理回源】时才设为 true（client/nginx.conf 已用
# $remote_addr 覆盖式写入 X-Real-IP，此时可安全开启）。
# TRUST_PROXY_HEADERS=false

# 是否信任 Cloudflare 回源头 CF-Connecting-IP
# 单独开关，因为该头只在「仅允许 Cloudflare 网段回源」时可信。
# TRUST_CF_CONNECTING_IP=false

# 本地开发用：显式允许使用不安全的 SECRET_KEY（生产环境绝不要设置）
# ALLOW_INSECURE_SECRET_KEY=true

# CORS 允许来源（多个用逗号分隔）。留空时使用 FRONTEND_URL；
# 生产环境前后端同源部署（nginx 反代）无需配置
# CORS_ORIGINS=

# 首个用户（超级管理员）注册码。留空时每次启动随机生成并打印到日志
# SUPERADMIN_INIT_CODE=

# 访问端口
PORT=80

# 站点对外地址。两个用途：
#   1) 邮件里赛事详情链接
#   2) 【重要】密码重置邮件里的链接——它带的是能改密码的凭证
# 生产部署（DEBUG=false）下必填，且不能是 localhost/127.0.0.1：
# 否则服务会拒绝启动（避免上线后才发现重置链接指向用户打不开的本机地址）。
# 本地开发照下面这样写即可（DEBUG=true 时不校验）。
FRONTEND_URL=http://localhost:5173

# 邮件通知（腾讯企业邮箱示例；未配置时跳过发送，不影响功能）
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=your-account@example.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM=your-account@example.com
# 注意：「忘记密码（邮箱找回）」依赖上面这几项 SMTP 配置。
# 未配置时接口仍正常返回，但重置邮件发不出去（日志会提示「密码重置邮件未发出」），
# 用户拿不到重置链接。另外账号必须填过邮箱才能用该方式找回。

# 防暴力尝试（可调整；不配置则使用默认值）
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600
INVITE_MAX_ATTEMPTS=3
INVITE_WINDOW_SECONDS=300

# ---- 审计/访问日志（可选，默认值即可） ----
# HTTP 访问日志文件路径（JSONL 格式，自动轮转）
# AUDIT_LOG_PATH=logs/access.log
# 单文件大小(MB) / 轮转份数
# AUDIT_LOG_MAX_MB=50
# AUDIT_LOG_BACKUPS=5
# 业务操作审计（audit_logs 表）总开关
# AUDIT_DB_ENABLED=true
# 是否记录高频操作（记分/投票），默认关闭避免日志膨胀
# AUDIT_HIGH_FREQ_ENABLED=false
# 审计记录保留天数，过期自动清理
# AUDIT_RETENTION_DAYS=90
