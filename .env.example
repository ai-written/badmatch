# BadMatch 环境变量配置
# 复制此文件为 .env 后修改

# 数据库密码（生产环境务必修改）
DB_PASSWORD=badminton

# JWT 密钥（生产环境必填！用 openssl rand -hex 32 生成；
# 使用默认值/示例值时生产模式将拒绝启动）
SECRET_KEY=change-me-to-a-random-64-char-string

# 生产模式开关（true=开发，false=生产）
# DEBUG=false 时：默认 SECRET_KEY 拒绝启动、SQL 不打印
DEBUG=false

# CORS 允许来源（多个用逗号分隔）。留空时使用 FRONTEND_URL；
# 生产环境前后端同源部署（nginx 反代）无需配置
# CORS_ORIGINS=

# 首个用户（超级管理员）注册码。留空时每次启动随机生成并打印到日志
# SUPERADMIN_INIT_CODE=

# 访问端口
PORT=80

# 前端访问地址（用于邮件中的赛事详情链接）
FRONTEND_URL=http://localhost:5173

# 邮件通知（腾讯企业邮箱示例；未配置时跳过发送，不影响功能）
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=your-account@example.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM=your-account@example.com

# 防暴力尝试（可调整；不配置则使用默认值）
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600
INVITE_MAX_ATTEMPTS=3
INVITE_WINDOW_SECONDS=300

# ---- 审计/访问日志（可选，默认值即可） ----
# HTTP 访问日志文件路径（JSONL 格式，自动轮转）
# AUDIT_LOG_PATH=logs/access.log
# 单文件大小(MB) / 轮转份数
# AUDIT_LOG_MAX_MB=50
# AUDIT_LOG_BACKUPS=5
# 业务操作审计（audit_logs 表）总开关
# AUDIT_DB_ENABLED=true
# 是否记录高频操作（记分/投票），默认关闭避免日志膨胀
# AUDIT_HIGH_FREQ_ENABLED=false
# 审计记录保留天数，过期自动清理
# AUDIT_RETENTION_DAYS=90
