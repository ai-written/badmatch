# ===== BadMatch 生产配置 =====
# 用法：把本文件拷到服务器，改成真实值，然后
#   docker compose -f docker-compose.prod.yml up -d

# 【必填】站点对外地址。缺省或指向 localhost 时服务会拒绝启动。
# 例：https://badminton.example.com  或  http://192.168.1.10:8080
FRONTEND_URL=https://your-domain.example.com

# 【必填】JWT 密钥。生成：openssl rand -hex 32
SECRET_KEY=

# 数据库密码（不设则为 badminton，强烈建议改掉）
DB_PASSWORD=

# 对外服务端口（默认 80）
PORT=80

# 【首次部署必填】用于注册第一个超级管理员；留空时服务会把随机码打印到日志
SUPERADMIN_INIT_CODE=

# 邮件（找回密码功能依赖它；不配则邮件发不出去，功能不可用）
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=your-account@example.com
SMTP_PASSWORD=
SMTP_FROM=your-account@example.com

# 请求都经 nginx 反代时保持 true；若 server 端口会被直接访问，必须改 false，
# 否则按 IP 的限流与审计 IP 可被伪造绕过
TRUST_PROXY_HEADERS=true